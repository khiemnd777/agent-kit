{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "execution_result"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]{8,64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "git_commit",
                "content_digest"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "git_commit"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "content_digest"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          ]
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "snapshot",
        "environment_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "timed_out",
        "escalated"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "effects_state": {
      "enum": [
        "none",
        "known",
        "unknown"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "SKIPPED"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "status",
          "detail",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          }
        },
        "required": [
          "id",
          "relative_path",
          "digest",
          "media_type",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "next_action": {
            "enum": [
              "reason",
              "authorize",
              "reconcile",
              "fix_environment",
              "none"
            ]
          },
          "related_check": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "next_action",
          "related_check"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "logs_truncated": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 864000
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "cache_read_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "cache_write_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasoning_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "unavailable_reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "cache_write_tokens",
            "reasoning_tokens",
            "source",
            "unavailable_reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "duration_seconds",
        "attempts",
        "usage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "request_digest",
    "run_id",
    "capability",
    "target",
    "status",
    "summary",
    "started_at",
    "finished_at",
    "effects_state",
    "checks",
    "artifacts",
    "exceptions",
    "logs_truncated",
    "metrics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Kit draft execution result 0.1.0",
  "description": "Terminal observed outcome; never human acceptance. Verify runtime authenticity separately."
}
