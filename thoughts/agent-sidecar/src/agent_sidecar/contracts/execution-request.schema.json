{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "execution_request"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]{8,64}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "git_commit",
                "content_digest"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "git_commit"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "content_digest"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          ]
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "snapshot",
        "environment_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "maxProperties": 64
    },
    "authorization": {
      "type": "object",
      "properties": {
        "scope_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "allowed_effects": {
          "type": "array",
          "items": {
            "enum": [
              "read_source",
              "write_scratch",
              "write_source",
              "network"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "network_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,252}$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "scope_id",
        "decision_ref",
        "allowed_effects",
        "allowed_paths",
        "network_hosts",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "required": {
            "type": "boolean"
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "id",
          "required",
          "criterion"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_summary_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "max_evidence_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      },
      "required": [
        "max_duration_seconds",
        "max_attempts",
        "max_concurrency",
        "max_summary_bytes",
        "max_evidence_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "objective",
    "capability",
    "target",
    "inputs",
    "authorization",
    "checks",
    "limits"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Kit draft execution request 0.1.0",
  "description": "Design contract only. Metadata does not establish or grant authority. No executor is included."
}
